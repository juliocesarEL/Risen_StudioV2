# ---------------------------------------------------------------------------
# Envio do formulário de orçamento (Resend — https://resend.com)
# ---------------------------------------------------------------------------
# Chave de API do Resend. Sem ela, o formulário exibe um erro honesto
# ("envio indisponível") e oferece WhatsApp/e-mail como alternativa.
RESEND_API_KEY=

# E-mail que recebe as solicitações de orçamento.
CONTACT_TO_EMAIL=

# Remetente usado no envio. Precisa ser de um domínio verificado no Resend.
# Para testes, o Resend permite "onboarding@resend.dev" (apenas para o e-mail
# da própria conta). Opcional: se vazio, usa o remetente de teste.
CONTACT_FROM_EMAIL="Risen Studio <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# URL pública do site, sem barra no final (usada em canonical, sitemap e
# Open Graph). Na Vercel, se vazia, usamos o domínio de produção do projeto.
# Exemplo: NEXT_PUBLIC_SITE_URL=https://risenstudio.com.br
NEXT_PUBLIC_SITE_URL=
